<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="SUPER_ADMIN_USER" value="superadmin@test.local"/>
        <env name="SUPER_ADMIN_PASSWORD" value="password"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_DATABASE" value="testing"/> -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Scout CI -->
        <env name="SCOUT_DRIVER" value="collection"/>
        <env name="SCOUT_QUEUE" value="false"/>
        <!-- Operation TZ defaults to UTC in tests so Carbon::today()
             (PHP default tz, also UTC) lines up with
             Carbon::now(config('app.operation_tz'))->startOfDay() in
             production code under test. Cross-TZ tests opt into a
             different value via the Tz helper in tests/Helpers. -->
        <env name="OPERATION_TZ" value="UTC"/>
        <!-- Neutralize the Google Maps keys in tests. Without an empty
             server key, every Service created in a test (QUEUE_CONNECTION
             is "sync", so FetchServiceRoute runs inline) would make a real,
             billable call to the Routes API. force="true" overrides the
             real keys the Sail container inherits from .env, so
             RoutesClient::driving() short-circuits to null with zero HTTP.
             Tests that exercise the route path fake the client explicitly. -->
        <env name="GOOGLE_MAPS_SERVER_KEY" value="" force="true"/>
        <env name="GOOGLE_MAPS_BROWSER_KEY" value="" force="true"/>
    </php>
</phpunit>
